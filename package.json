{
  "name": "githost",
  "version": "0.1.0",
  "private": true,
  "description": "Local GitHub mirror with AI bot review and custom views.",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "bash scripts/ensure-dev-vars.sh && npm run build && concurrently -n worker,web -c blue,green \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:worker": "bash scripts/ensure-dev-vars.sh && wrangler dev",
    "dev:web": "npm -w web run dev",
    "build": "npm -w web run build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm -w web run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cli": "cmake -S cli -B cli/build && cmake --build cli/build && cli/tests/run_tests.sh cli/build/githost",
    "build:cli": "cmake -S cli -B cli/build -DCMAKE_BUILD_TYPE=Release && cmake --build cli/build",
    "review": "cli/bin/githost-review",
    "db:generate:mirror": "drizzle-kit generate --config drizzle.config.mirror.ts",
    "db:generate:app": "drizzle-kit generate --config drizzle.config.app.ts",
    "db:apply:mirror:local": "wrangler d1 migrations apply githost-mirror --local",
    "db:apply:app:local": "wrangler d1 migrations apply githost-app --local",
    "db:apply:mirror:remote": "wrangler d1 migrations apply githost-mirror --remote",
    "db:apply:app:remote": "wrangler d1 migrations apply githost-app --remote",
    "db:apply:local": "npm run db:apply:mirror:local && npm run db:apply:app:local",
    "db:apply:remote": "npm run db:apply:mirror:remote && npm run db:apply:app:remote",
    "dev:seed": "./scripts/seed-local.sh",
    "db:export:mirror": "wrangler d1 export githost-mirror --remote --output backups/mirror-$(date -u +%Y%m%dT%H%M%SZ).sql",
    "db:export:app": "wrangler d1 export githost-app --remote --output backups/app-$(date -u +%Y%m%dT%H%M%SZ).sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.4",
    "@cloudflare/workers-types": "^4.20250501.0",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.28.0",
    "msw": "^2.14.6",
    "typescript": "^5.6.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.90.1"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.9",
    "jose": "^5.9.6"
  }
}
